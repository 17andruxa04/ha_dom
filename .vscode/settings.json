{
    "files.associations": {
        "*.yaml": "home-assistant",
        "compose.yml": "yaml",
        "compose.yaml": "yaml",
        "compose.*.yml": "yaml",
        "compose.*.yaml": "yaml",
        "docker-compose.yml": "yaml",
        "docker-compose.yaml": "yaml",
        "docker-compose.*.yml": "yaml",
        "docker-compose.*.yaml": "yaml",
        "esphome/**/*.yml": "esphome",
        "esphome/**/*.yaml": "esphome"
    },
    "yaml.customTags": [
        "!include scalar",
        "!include_dir_list scalar",
        "!include_dir_merge_list scalar",
        "!include_dir_named scalar",
        "!include_dir_merge_named scalar",
        "!secret scalar",
        "!env_var scalar"
    ],
    "yaml.schemas": {
        "https://json.schemastore.org/home-assistant.json": [
            "configuration.yaml"
        ]
    }
}
